{
  "manifest_version": 3,
  "name": "WebLens – Task-Aware Webpage Intelligence",
  "version": "1.0.0",
  "description": "Analyzes webpages through task-specific lenses (Learn, Compare, Decide, Technical, Custom), organizing content and highlighting evidence directly on the page.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "WebLens",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "shared/constants.js",
        "shared/messageTypes.js",
        "shared/utils.js",
        "content/domExtractor.js",
        "content/highlighter.js",
        "content/pageState.js",
        "core/relevanceEngine.js",
        "core/evidenceExtractor.js",
        "core/gapDetector.js",
        "core/informationMap.js",
        "core/taskAnalyzer.js",
        "core/taskController.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
